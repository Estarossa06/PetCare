# Copy to api/.env and replace the placeholders locally.
# Never commit populated environment files or print connection URLs in logs.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a random secret locally (minimum 32 bytes); do not reuse this file's placeholder.
AUTH_ACCESS_TOKEN_SECRET=
# Google Web OAuth is optional locally. Keep GOOGLE_OAUTH_CLIENT_SECRET only in the API environment.
# Configure all four together; never use EXPO_PUBLIC_* for the client secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_WEB_RETURN_URL=
# Required when Google OAuth is enabled; Resend is currently supported.
# Set AUTH_EMAIL_PROVIDER=resend, RESEND_API_KEY and AUTH_EMAIL_FROM together in the API environment.
AUTH_EMAIL_PROVIDER=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Comma-separated browser origins. Leave empty to disable browser CORS access.
CORS_ORIGINS=http://localhost:8098,http://127.0.0.1:8098
# Local Ollama vision provider for optional pet photo suggestions (install a vision model first).
PET_VISION_OLLAMA_BASE_URL=http://127.0.0.1:11434
PET_VISION_OLLAMA_MODEL=qwen2.5vl:7b
PET_VISION_TIMEOUT_MS=90000
# Optional private Cloudflare R2 storage. Configure all four values together in the API environment only.
# Create an R2 API token scoped to the one private bucket. Never add these to mobile/.env files.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PostgreSQL integration tests only. Use a disposable, isolated database named petcare_test.
# Uncomment and configure these locally; never point them at production.
# PETCARE_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/petcare_test?sslmode=require
# PETCARE_RUN_AUTH_DB_TESTS=1
# PETCARE_RUN_MEDIA_DB_TESTS=1
