# Copy to api/.env and replace the placeholders locally.
# Never commit populated environment files or print connection URLs in logs.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a random secret locally (minimum 32 bytes); do not reuse this file's placeholder.
AUTH_ACCESS_TOKEN_SECRET=
# Comma-separated browser origins. Leave empty to disable browser CORS access.
CORS_ORIGINS=http://localhost:8098,http://127.0.0.1:8098
