{
  "expo": {
    "name": "PetCare",
    "slug": "petcare",
    "scheme": "petcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/brand/petcare-heart-paw.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/petcare-heart-paw.png"
    },
    "ios": {
      "bundleIdentifier": "com.petcare.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.petcare.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/petcare-heart-paw.png",
        "backgroundColor": "#022B9E"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetCare necesita acceso a la galería para elegir una foto de tu mascota.",
          "cameraPermission": "PetCare necesita acceso a la cámara para fotografiar a tu mascota."
        }
      ],
      "./plugins/withCmakeObjectPathLimit",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/petcare-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F8FC",
          "dark": {
            "image": "./assets/brand/petcare-adaptive-foreground.png",
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6a301adf-597e-4b4f-9f67-99c8e652f514"
      }
    },
    "owner": "xxestarossaxx"
  }
}
